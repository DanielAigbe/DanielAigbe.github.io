---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';

export async function getStaticPaths() {
  const all = (await getCollection('work', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, index: i + 1, next: all[(i + 1) % all.length] },
  }));
}
const { entry, index, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const meta = [
  ['Role', d.role],
  ['Client', d.client],
  ['Year', d.year],
  ['Tools', d.tools],
];
---
<Base
  title={`${d.title} case study`}
  description={d.summary}
  current="Work"
  image={`/og/${entry.id}.jpg`}
  imageAlt={`${d.title} case study by Daniel Aigbe`}
  type="article"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: d.title,
    headline: `${d.title} case study`,
    description: d.summary,
    url: new URL(`/work/${entry.id}/`, Astro.site).href,
    image: new URL(`/og/${entry.id}.jpg`, Astro.site).href,
    dateCreated: d.year,
    keywords: d.tags.join(', '),
    creator: { '@type': 'Person', name: 'Daniel Aigbe', alternateName: 'UI_RONIN', url: new URL('/', Astro.site).href },
  }}
>
  <header class="head">
    <span class="kicker">P/{String(index).padStart(2, '0')} — Case study</span>
    <h1>{d.title}<span class="red">_</span></h1>
    <p class="intro">{d.intro}</p>
    <dl class="meta">
      {meta.map(([k, v]) => (
        <div><dt>{k}</dt><dd>{v}</dd></div>
      ))}
    </dl>
  </header>

  <div class="hero-cover" data-parallax="0.05"><Cover {...d.cover} tall /></div>

  <main class="body">
    <Content />
  </main>

  <a class="next" href={`/work/${next.id}/`}>
    <div><span class="kicker">Next project</span><b>{next.data.title}</b></div>
    <span class="arrow">→</span>
  </a>
</Base>

<style>
  .head { padding: 100px var(--gutter) 72px; display: flex; flex-direction: column; gap: 28px; }
  h1 { font-weight: 700; font-size: clamp(40px, 7.8vw, 112px); line-height: 1; }
  .intro { max-width: 760px; font-size: clamp(18px, 1.6vw, 22px); line-height: 1.5; color: var(--mist); }
  .meta { margin: 32px 0 0; padding-top: 28px; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 24px; }
  .meta div { display: flex; flex-direction: column; gap: 8px; }
  dt { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.15em; color: var(--stone); text-transform: uppercase; }
  dd { margin: 0; }
  .hero-cover { padding: 0 var(--edge); }

  /* Case study text. Each "## Heading" in the Markdown becomes a numbered section. */
  .body { padding: 100px var(--gutter) 0; counter-reset: sec; display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 8fr); column-gap: 8%; row-gap: 20px; }
  .body > :global(*) { grid-column: 2; margin: 0; }
  .body :global(h2) {
    grid-column: 1;
    counter-increment: sec;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 26px;
    line-height: 1.2;
    margin-top: 76px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .body :global(h2:first-child) { margin-top: 0; }
  .body :global(h2::before) { content: counter(sec, decimal-leading-zero); font-family: var(--font-mono); font-size: 13px; color: var(--crimson); }
  .body :global(h2 + *) { margin-top: 76px; }
  .body :global(h2:first-child + *) { margin-top: 0; }
  .body :global(p), .body :global(li) { font-size: 20px; line-height: 1.65; color: var(--mist); }
  .body :global(ul) { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 24px; }
  .body :global(li) { padding-left: 20px; border-left: 1px solid var(--line-strong); }
  .body :global(li strong) { display: block; color: var(--washi); font-weight: 500; margin-bottom: 6px; }
  .body :global(img) { width: 100%; }
  /* A "> [Image: ...]" line in the Markdown shows as a placeholder box until you swap in a real image. */
  .body :global(blockquote) {
    min-height: 320px;
    background: var(--charcoal);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
  }
  .body :global(blockquote p) { font-family: var(--font-mono); font-size: 13px; color: var(--dim); }
  .body :global(.swatches) { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 24px; }
  .body :global(.swatches div) { display: flex; flex-direction: column; gap: 6px; }
  .body :global(.swatches i) { height: 160px; border: 1px solid var(--line); margin-bottom: 6px; }
  .body :global(.swatches b) { font-weight: 500; }
  .body :global(.swatches span) { font-family: var(--font-mono); font-size: 13px; color: var(--stone); }

  .next { margin: 160px var(--edge) 0; padding: 64px clamp(0px, 4vw, 56px); border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; gap: 24px; }
  .next div { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .next b { font-family: var(--font-display); font-weight: 700; font-size: clamp(30px, 4.4vw, 64px); line-height: 1.1; }
  .arrow { font-family: var(--font-display); font-size: 48px; color: var(--crimson); transition: transform 0.25s ease; }
  .next:hover .arrow { transform: translateX(10px); }

  @media (max-width: 820px) {
    .head { padding-top: 56px; }
    .body { grid-template-columns: 1fr; padding-top: 64px; }
    .body > :global(*), .body :global(h2) { grid-column: 1; }
    .body :global(h2 + *) { margin-top: 0; }
    .body :global(h2) { margin-top: 48px; }
    .body :global(p), .body :global(li) { font-size: 18px; }
    .next { margin-top: 90px; }
  }
</style>
