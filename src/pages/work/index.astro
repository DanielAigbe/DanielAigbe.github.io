---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';

const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Work" current="Work" description="Selected work by Daniel Aigbe (UI_RONIN): product design, website design, mobile apps and brand identity for ODARA, PawsBook, iAfricano, e-Flames & Flavours and Vicelle.">
  <header class="head">
    <span class="kicker">01 — Work</span>
    <h1>All projects<span class="red">_</span></h1>
  </header>
  <main class="grid">
    {projects.map((p) => {
      const Tag = p.data.draft ? 'div' : 'a';
      return (
        <Tag class="card reveal" href={p.data.draft ? undefined : `/work/${p.id}/`}>
          <Cover {...p.data.cover} />
          <div class="line">
            <h2>{p.data.title}</h2>
            <span>{p.data.status ?? p.data.tags.slice(0, 2).join(' · ')}</span>
          </div>
          <p>{p.data.summary}</p>
        </Tag>
      );
    })}
  </main>
</Base>

<style>
  .head { padding: 100px var(--gutter) 56px; display: flex; flex-direction: column; gap: 28px; }
  h1 { font-weight: 700; font-size: clamp(40px, 6.7vw, 96px); line-height: 1.02; }
  .grid { padding: 0 var(--gutter) 140px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 72px 24px; }
  .card { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .line { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; }
  .line h2 { font-weight: 700; font-size: 28px; }
  .line span { font-family: var(--font-mono); font-size: 12px; color: var(--stone); text-transform: uppercase; }
  .card p { color: var(--mist); }
  a.card:hover :global(.cover) { transform: translateY(-6px); }
</style>
