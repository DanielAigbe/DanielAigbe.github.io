---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Cover from '../components/Cover.astro';
import SplineScene from '../components/SplineScene.jsx';

const projects = (await getCollection('work', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');

const services = [
  { n: 'S/01', title: 'Product & UX design', text: 'Web and mobile interfaces, user flows and prototypes, built on design systems with tokens that hand off cleanly to code.' },
  { n: 'S/02', title: 'Frontend development', text: 'Responsive, production-ready frontends in Angular, React and plain HTML/CSS. I work on an enterprise fintech platform day to day.' },
  { n: 'S/03', title: 'Brand identity', text: "Logos, brand guides and visual systems. I've been doing identity work since 2020." },
];
---
<Base hideNav>
  <div class="home">
  <!-- Background glows for the whole page. Each <i> is one glow; move or resize them in the CSS under "Background glows". -->
  <div class="bg-glows" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <header class="hero">
    <img class="hero-logo" data-parallax="0.22" src="/images/logo.webp" alt="UI_RONIN logo: a torii gate against a full moon" width="1400" height="1400" />
    <div class="slash" aria-hidden="true"></div>
    <Nav />
    <div class="hero-copy">
      <div class="disc">
        <i></i>
        <p data-scramble="PRODUCT DESIGN|FRONTEND DEV|BRAND IDENTITY">PRODUCT DESIGN</p>
      </div>
      <h1 class="name">UI<span class="red">_</span>RONIN</h1>
      <p class="hero-text late">I'm Daniel Aigbe, a product designer and frontend developer. I design and build digital products, from brand identity to the interface and the code behind it.</p>
      <div class="actions late">
        <a class="btn" href="/contact/">Start a project</a>
        <a class="link" href="#work">View selected work</a>
      </div>
    </div>
    <div class="hero-foot">
      <span class="scroll">SCROLL <i></i></span>
      <span>Lagos · 6.52°N 3.38°E</span>
    </div>
  </header>

  <main>
    <section class="work" id="work">
      <div class="section-head reveal">
        <div>
          <span class="kicker">01 — Selected work</span>
          <h2>Recent projects<span class="red">.</span></h2>
        </div>
        <a class="link" href="/work/">All projects</a>
      </div>
      {projects.map((p, i) => (
        <a class:list={['row', 'reveal', { flip: i % 2 === 1 }]} href={`/work/${p.id}/`}>
          <div class="row-cover" data-parallax="0.06"><Cover {...p.data.cover} /></div>
          <div class="row-info">
            <span class="code">P/{pad(i + 1)}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.summary}</p>
            <div class="tags">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
            <span class="more">Read case study <span class="red">→</span></span>
          </div>
        </a>
      ))}
    </section>

    <section class="approach reveal">
      <img src="/images/kanji.webp" alt="" loading="lazy" data-parallax="0.22" />
      <span class="kicker">02 — The approach</span>
      <p>I design it, then I build it. One person from the first sketch to the shipped code<span class="red">_</span></p>
    </section>

    <section class="services" id="services">
      <div class="section-head reveal">
        <div>
          <span class="kicker">03 — Services</span>
          <h2>What I do<span class="red">.</span></h2>
        </div>
      </div>
      <div class="cards">
        {services.map((s) => (
          <div class="card reveal">
            <span class="code">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="play">
      <div class="play-hero">
        <div class="play-copy reveal">
          <span class="kicker">04 — Playground</span>
          <h2>3D experiments<span class="red">.</span></h2>
          <p class="lede">Small objects I model in Spline between screens. This one is live: move your mouse over it.</p>
          <span class="play-tag">Mini keyboard · Spline</span>
        </div>
        <div class="play-stage">
          <SplineScene client:visible={{ rootMargin: "800px" }} bare scene="https://prod.spline.design/EGc3F3-90x4h996Z/scene.splinecode" alt="Mini keyboard with four keys, modelled in Spline" title="Mini keyboard" />
        </div>
      </div>
      <div class="play-hero flip">
        <div class="play-stage">
          <SplineScene client:visible={{ rootMargin: "800px" }} bare scene="https://prod.spline.design/d30RvUfgmsMJgWVL/scene.splinecode" alt="Miniature workspace room, modelled in Spline" title="Mini room" />
        </div>
        <div class="play-copy reveal">
          <p class="lede">A small corner of a workspace, built piece by piece. It's live too: move around it.</p>
          <span class="play-tag">Mini room · Spline</span>
        </div>
      </div>
    </section>

    <section class="contact reveal">
      <img src="/images/moon-torii.webp" alt="" loading="lazy" data-parallax="0.16" />
      <span class="kicker">05 — Contact</span>
      <h2>Got a project<br />in mind<span class="red">?</span></h2>
      <p class="lede">Tell me what you're building. I reply within a day or two.</p>
      <div class="actions">
        <a class="btn" href="/contact/">Start a project</a>
        <a class="link mono" href="mailto:aigbeerumusele@gmail.com">aigbeerumusele@gmail.com</a>
      </div>
    </section>
  </main>
  </div>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: min(810px, 100svh);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .hero-logo {
    position: absolute;
    right: -18.6%;
    top: 44px;
    width: 69%;
    max-width: 995px;
    height: auto;
    animation: rise 1.8s ease-out 0.1s both;
  }
  .slash {
    position: absolute;
    left: 39%;
    top: 520px;
    width: 76%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--crimson) 40%, transparent);
    transform-origin: left center;
    transform: rotate(-24deg);
    animation: slash 1.1s cubic-bezier(0.7, 0, 0.2, 1) 0.4s both;
  }
  .hero-copy {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    padding: 40px var(--gutter);
  }
  .disc { display: flex; align-items: center; gap: 16px; }
  .disc i { width: 48px; height: 1px; background: var(--crimson); flex: none; }
  .disc p { font-family: var(--font-mono); font-size: 14px; letter-spacing: 0.18em; color: var(--mist); white-space: nowrap; }
  .name {
    font-weight: 700;
    font-size: clamp(44px, 9.2vw, 132px);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    animation: rise 0.9s ease-out 0.5s both;
  }
  .hero-text { max-width: 520px; font-size: 19px; color: var(--mist); }
  .late { animation: rise 0.9s ease-out 0.9s both; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 28px; }
  .hero-foot {
    position: relative;
    display: flex;
    justify-content: space-between;
    padding: 0 var(--edge) 32px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--stone);
  }
  .scroll { display: inline-flex; align-items: center; gap: 12px; letter-spacing: 0.2em; }
  .scroll i { width: 64px; height: 1px; background: var(--washi); }
  @keyframes rise { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
  @keyframes slash { from { transform: rotate(-24deg) scaleX(0); } to { transform: rotate(-24deg) scaleX(1); } }

  /* ---------- Shared section bits ---------- */
  .code { font-family: var(--font-mono); font-size: 13px; color: var(--stone); }
  .mono { font-family: var(--font-mono); font-size: 15px; }

  /* ---------- Work ---------- */
  .work { padding: 140px var(--gutter) 60px; display: flex; flex-direction: column; gap: 72px; }
  .row { display: grid; grid-template-columns: 7fr 4fr; column-gap: 10.5%; align-items: center; }
  .row.flip { grid-template-columns: 4fr 7fr; }
  .row.flip .row-cover { order: 2; }
  .row-info { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .row-info h3 { font-weight: 700; font-size: clamp(26px, 2.8vw, 40px); line-height: 1.1; }
  .row-info p { color: var(--mist); font-size: 18px; }
  .more { font-weight: 500; }
  .row:hover .row-cover :global(.cover) { transform: translateY(-6px); }

  /* ---------- Approach ---------- */
  .approach { position: relative; padding: 140px var(--gutter); display: flex; flex-direction: column; gap: 28px; }
  .approach img { position: absolute; right: 80px; top: 40px; width: min(360px, 40%); }
  .approach p { position: relative; max-width: 980px; font-family: var(--font-display); font-weight: 500; font-size: clamp(26px, 3.4vw, 48px); line-height: 1.2; }
  .approach .kicker { position: relative; }

  /* ---------- Services ---------- */
  .services { padding: 60px var(--gutter) 140px; display: flex; flex-direction: column; gap: 56px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
  .card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 36px 32px;
    background: var(--surface);
    border-top: 2px solid var(--crimson);
  }
  .js .card.reveal.in { transition: opacity 0.8s ease, transform 0.25s ease, background 0.25s ease; }
  .card:hover { background: #151312; }
  .js .card.reveal.in:hover { transform: translateY(-6px); }
  .card h3 { font-weight: 500; font-size: 26px; line-height: 1.2; }
  .card p { color: var(--mist); }

  /* ---------- Playground ---------- */
  .play { padding: 0 var(--gutter) 140px; display: flex; flex-direction: column; gap: 56px; }
  /* Title beside the live keyboard */
  .play-hero { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); align-items: center; gap: 40px; }
  .play-copy { display: flex; flex-direction: column; gap: 20px; }
  .play-copy h2 { font-weight: 700; font-size: clamp(30px, 4vw, 56px); line-height: 1.05; }
  .play-copy .lede { max-width: 36ch; }
  .play-tag { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--stone); }
  .play-stage { min-width: 0; }
  .play-hero.flip { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); }
  .play-stage :global(.spline.bare) { aspect-ratio: 1 / 1; max-height: 80vh; }
  /* One scene per row, so each is big enough to play with. */
  .pieces { display: grid; grid-template-columns: 1fr; gap: 64px; }
  .piece { margin: 0; display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .piece figcaption { display: flex; justify-content: space-between; align-items: baseline; }
  .piece b { font-weight: 500; font-size: 18px; }
  .piece span { font-family: var(--font-mono); font-size: 12px; color: var(--stone); }

  /* ---------- Contact ---------- */
  .contact {
    position: relative;
    overflow: hidden;
    padding: 160px var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    border-top: 1px solid var(--line);
  }
  .contact > * { position: relative; }
  .contact img { position: absolute; right: -120px; top: 60px; width: min(620px, 55%); opacity: 0.9; }
  .contact h2 { font-weight: 700; font-size: clamp(40px, 6.1vw, 88px); line-height: 1.02; }

  /* ---------- Background glows: one layer behind the whole page, so they cross section edges ---------- */
  .home { position: relative; isolation: isolate; }
  .bg-glows { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .bg-glows i {
    position: absolute;
    width: 1200px;
    height: 1200px;
    border-radius: 50%;
    /* --a is the strength of each glow */
    background: radial-gradient(closest-side, rgba(200, 16, 46, var(--a, 0.26)), rgba(200, 16, 46, calc(var(--a, 0.26) * 0.45)) 40%, rgba(200, 16, 46, calc(var(--a, 0.26) * 0.14)) 68%, rgba(200, 16, 46, 0) 100%);
  }
  /* Placed away from the moon and kanji, alternating sides down the page */
  .bg-glows i:nth-child(1) { left: -420px; top: 420px; --a: 0.3; }
  .bg-glows i:nth-child(2) { right: -520px; top: 20%; width: 1300px; height: 1300px; --a: 0.24; }
  .bg-glows i:nth-child(3) { left: -480px; top: 37%; --a: 0.26; }
  .bg-glows i:nth-child(4) { left: 18%; top: 54%; width: 1400px; height: 1000px; --a: 0.2; }
  .bg-glows i:nth-child(5) { right: -460px; top: 68%; --a: 0.26; }
  .bg-glows i:nth-child(6) { left: -380px; bottom: -420px; width: 1300px; height: 1300px; --a: 0.32; }

  @media (max-width: 820px) {
    .play-hero, .play-hero.flip { grid-template-columns: 1fr; }
    .play-hero.flip .play-copy { order: -1; }
    .hero-logo { position: relative; right: auto; top: auto; width: 78%; margin: 8px auto -8%; order: 2; }
    .hero .slash { display: none; }
    .hero-copy { order: 3; padding-top: 0; }
    .hero-foot { order: 4; }
    .disc p { font-size: 11px; letter-spacing: 0.12em; }
    .hero-text { font-size: 17px; }
    .work { padding-top: 80px; gap: 56px; }
    .row, .row.flip { grid-template-columns: 1fr; row-gap: 24px; }
    .row.flip .row-cover { order: 0; }
    .approach, .contact { padding-block: 90px; }
    .approach img { right: 10px; opacity: 0.6; }
    .contact img { right: -30%; width: 90%; opacity: 0.35; }
    .services, .play { padding-bottom: 90px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-logo, .slash, .name, .late { animation: none; }
  }
</style>
