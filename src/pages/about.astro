---
import Base from '../layouts/Base.astro';

const path = [
  ['2020', 'Graphic and logo design'],
  ['2022', 'UI/UX and product design'],
  ['2026', 'Frontend developer, Union Systems Limited'],
  ['NOW', 'Fintech frontend by day, freelance product design alongside'],
];
const toolkit = [
  ['Design', ['Figma', 'Tokens Studio', 'Adobe Illustrator', 'Framer']],
  ['Code', ['Angular', 'React / Vite', 'Tailwind CSS', 'CSS animation']],
  ['3D', ['Spline']],
];
---
<Base title="About" current="About">
  <header class="head">
    <div class="intro">
      <span class="kicker">03 — About</span>
      <h1>Designer.<br />Developer.<br />Ronin<span class="red">_</span></h1>
      <p>I'm Daniel Aigbe, a product designer and frontend developer in Lagos. I work under the name UI_RONIN.</p>
    </div>
    <img class="portrait" src="/images/portrait.webp" alt="Daniel Aigbe" width="812" height="1184" />
  </header>

  <main class="body">
    <section class="reveal">
      <h2><span>01</span>The short version</h2>
      <div>
        <p>I started in graphic and logo design in 2020 and moved into UI/UX and product design in 2022. Today I'm a frontend developer at Union Systems Limited, where I work on Egora, an enterprise fintech platform.</p>
        <p>Alongside that I take on freelance design work. Clients include PawsBook, Odara Health, Vicelle and others.</p>
      </div>
    </section>
    <section class="reveal">
      <h2><span>02</span>Why "ronin"</h2>
      <div>
        <p>A ronin was a samurai without a master: trained, disciplined, and answerable to his own code. That is how I try to work. I hold myself to my own standard, and I see a project through on my own, from the first sketch to the shipped code.</p>
        <p>The logo carries the same idea. The torii gate is the passage every project goes through, from idea to product. The moon behind it is the calm focus the work needs. The kanji 浪 is the first character of rōnin, 浪人.</p>
      </div>
    </section>
    <section class="reveal">
      <h2><span>03</span>The path</h2>
      <ol class="path">
        {path.map(([y, t]) => <li><span class:list={{ red: y === 'NOW' }}>{y}</span>{t}</li>)}
      </ol>
    </section>
    <section class="reveal">
      <h2><span>04</span>Toolkit</h2>
      <div class="tools">
        {toolkit.map(([k, items]) => (
          <div><span class="k">{k}</span>{(items as string[]).map((i) => <span>{i}</span>)}</div>
        ))}
      </div>
    </section>
  </main>

  <section class="cta reveal">
    <h2>Let's work<br />together<span class="red">.</span></h2>
    <a class="btn" href="/contact/">Start a project</a>
  </section>
</Base>

<style>
  .head { padding: 100px var(--gutter) 120px; display: grid; grid-template-columns: 7fr 4fr; column-gap: 10.5%; align-items: end; }
  .intro { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  h1 { font-weight: 700; font-size: clamp(40px, 6.7vw, 96px); line-height: 1.02; }
  .intro p { max-width: 620px; font-size: clamp(18px, 1.6vw, 22px); line-height: 1.5; color: var(--mist); }
  .portrait { width: 100%; height: auto; object-fit: cover; object-position: 50% 20%; aspect-ratio: 384 / 560; clip-path: polygon(0 0, calc(100% - 28px) 0, 100% 28px, 100% 100%, 28px 100%, 0 calc(100% - 28px)); }
  .body { padding: 0 var(--gutter) 60px; display: flex; flex-direction: column; gap: 96px; }
  section { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 8fr); column-gap: 8%; }
  .body h2 { font-weight: 500; font-size: 26px; line-height: 1.2; display: flex; flex-direction: column; gap: 10px; }
  .body h2 span { font-family: var(--font-mono); font-size: 13px; color: var(--crimson); }
  .body section > div:not(.tools) { display: flex; flex-direction: column; gap: 18px; }
  .body p { font-size: 20px; line-height: 1.65; color: var(--mist); }
  .path { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .path li { display: flex; gap: 32px; padding: 22px 0; border-top: 1px solid var(--line); font-size: 19px; }
  .path span { font-family: var(--font-mono); font-size: 14px; color: var(--stone); width: 80px; flex: none; }
  .path span.red { color: var(--crimson); }
  .tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 24px; }
  .tools div { display: flex; flex-direction: column; gap: 6px; font-size: 18px; }
  .tools .k { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.15em; color: var(--stone); text-transform: uppercase; margin-bottom: 6px; }
  .cta { display: flex; grid-template-columns: none; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 32px; padding: 140px var(--gutter); }
  .cta h2 { font-weight: 700; font-size: clamp(34px, 4.4vw, 64px); line-height: 1.05; }
  @media (max-width: 820px) {
    .head { grid-template-columns: 1fr; row-gap: 40px; padding: 56px var(--gutter) 80px; }
    .portrait { max-width: 320px; }
    section { grid-template-columns: 1fr; row-gap: 20px; }
    .body { gap: 64px; }
    .body p { font-size: 18px; }
    .cta { padding-block: 90px; }
  }
</style>
