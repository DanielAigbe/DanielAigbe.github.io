---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.jsx';
const EMAIL = 'aigbeerumusele@gmail.com';
---
<Base title="Contact" current="Contact" description="Start a project with Daniel Aigbe (UI_RONIN), product designer and frontend developer in Lagos. Product design, websites, mobile apps and brand identity.">
  <main class="wrap">
    <img class="kanji" data-parallax="0.15" src="/images/kanji.webp" alt="" />
    <div class="intro">
      <span class="kicker">04 — Contact</span>
      <h1>Start a<br />project<span class="red">_</span></h1>
      <p>Tell me what you're building and where you're stuck. I reply within a day or two.</p>
      <div class="direct">
        <span class="kicker small">Or email directly</span>
        <a class="link big" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </div>
    </div>

    <!-- React component: src/components/ContactForm.jsx -->
    <ContactForm client:load email={EMAIL} />
  </main>
</Base>

<style>
  .wrap { position: relative; overflow: hidden; padding: 100px var(--gutter) 120px; display: grid; grid-template-columns: 6fr 5fr; column-gap: 8.5%; }
  .wrap > * { position: relative; }
  .wrap > .kanji { position: absolute; left: -60px; bottom: -40px; width: min(520px, 45%); }
  .intro { display: flex; flex-direction: column; gap: 28px; min-width: 0; }
  h1 { font-weight: 700; font-size: clamp(40px, 6.7vw, 96px); line-height: 1.02; }
  .intro p { max-width: 460px; font-size: 20px; color: var(--mist); }
  .direct { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; margin-top: 24px; }
  .small { font-size: 12px; letter-spacing: 0.15em; }
  .big { font-size: clamp(17px, 1.7vw, 24px); overflow-wrap: anywhere; }
  @media (max-width: 820px) {
    .wrap { grid-template-columns: 1fr; row-gap: 48px; padding: 56px var(--gutter) 80px; }
    .kanji { display: none; }
  }
</style>
